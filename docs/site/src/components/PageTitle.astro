---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const slug = Astro.locals.starlightRoute.entry.id.replace(/^docs\//, '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Default />
<p class="hos-page-links">
  <a href={`${base}docs/${slug}.md`}>View as Markdown</a>
  <span aria-hidden="true">·</span>
  <a href={`${base}llms.txt`}>llms.txt</a>
</p>

<style>
  .hos-page-links {
    margin: 0.25rem 0 0;
    font: 500 0.8rem var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .hos-page-links span {
    margin: 0 0.4em;
  }
  .hos-page-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .hos-page-links a:hover {
    color: var(--sl-color-accent-high);
  }
</style>
