{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hos policy (the brain's hos/policy.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "handoff": { "$ref": "#/$defs/tokens" },
        "backstop": { "$ref": "#/$defs/backstop" },
        "single_line": { "$ref": "#/$defs/tokens" },
        "work_root": { "type": "string", "pattern": "^[^/~].*" },
        "agents": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/harnessId" },
          "additionalProperties": { "$ref": "#/$defs/contextOverride" }
        },
        "workspaces": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "additionalProperties": { "$ref": "#/$defs/contextOverride" }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^\\w+_running$": { "$ref": "#/$defs/count" } },
      "properties": {
        "idle_suspend_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_spawns_per_10_minutes": { "$ref": "#/$defs/count" },
        "dedup_window_hours": { "type": "integer", "minimum": 0 },
        "similarity_needs_approval": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cross_chat_context_share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "provider_windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "five_hour_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_pct", "effect"],
            "properties": {
              "at_pct": { "$ref": "#/$defs/pct" },
              "effect": { "enum": ["cheaper_models", "top_priorities_only", "pause_batch"] }
            }
          }
        },
        "weekly_batch_off_pct": { "$ref": "#/$defs/pct" },
        "peak_defer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["days", "start", "end", "timezone"],
          "properties": {
            "days": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
            },
            "start": { "$ref": "#/$defs/clock" },
            "end": { "$ref": "#/$defs/clock" },
            "timezone": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "properties": { "preset": true }, "required": ["preset"] },
        {
          "properties": { "A0": true, "A1": true, "A2": true, "A3": true, "A4": true, "A5": true, "A6": true, "A6b": true, "A7": true, "A8": true },
          "required": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A6b", "A7", "A8"]
        }
      ],
      "properties": {
        "preset": { "enum": ["ask_first", "balanced", "auto"], "description": "the starting rules; a class row set here changes just that row" },
        "A0": { "$ref": "#/$defs/approvalClass" },
        "A1": { "$ref": "#/$defs/approvalClass" },
        "A2": { "$ref": "#/$defs/approvalClass" },
        "A3": { "$ref": "#/$defs/approvalClass" },
        "A4": { "$ref": "#/$defs/approvalClass" },
        "A5": { "$ref": "#/$defs/approvalClass" },
        "A5w": { "$ref": "#/$defs/approvalClass" },
        "A6": { "$ref": "#/$defs/approvalClass" },
        "A6b": { "$ref": "#/$defs/approvalClass" },
        "A7": { "$ref": "#/$defs/approvalClass" },
        "A8": { "$ref": "#/$defs/approvalClass" },
        "unclassified": { "$ref": "#/$defs/outcome" },
        "plugin_edits": { "enum": ["follow", "ask_every_time"], "description": "changing plug-in code, the plugins list or harnesses: follow (the default) uses the A8 row, ask_every_time asks each time" }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "list"],
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "effort": { "$ref": "#/$defs/effort" },
        "list": { "$ref": "#/$defs/modelList" }
      }
    },
    "composer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paste_as_file_chars": { "type": "integer", "minimum": 1 }
      }
    },
    "transport": { "enum": ["tailscale", "cloudflare"], "description": "leave it out to keep hos on this computer only (loopback)" },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "aud", "hostname", "previews", "email"],
      "properties": {
        "team": { "type": "string", "minLength": 1 },
        "aud": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "previews": { "type": "string", "pattern": "\\{port\\}" },
        "email": { "type": "string", "minLength": 1 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 60 },
        "timezone_label": { "type": "string", "pattern": "^[^\\s·]{1,12}$" },
        "words": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mishears": { "type": "object", "propertyNames": { "pattern": "^[\\w'-]+$" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "work_remotes": { "type": "array", "items": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" } },
    "read_only_mcp": { "type": "array", "items": { "type": "string", "pattern": "^[\\w-]+$" }, "description": "MCP servers whose search, read, list and get tools only read (A0)" },
    "script_classes": {
      "type": "object",
      "description": "part of a script path → the action class hos judges that script as",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A5w", "A6", "A6b", "A7", "A8"] }
    },
    "repo_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "retention_days": { "type": "integer", "minimum": 0 } }
    },
    "plugins": {
      "type": "array",
      "description": "plug-in files in hos/plugins/ that hos loads at start; each provides data sources (tasks, capture, calendar, snags), notifiers or harnesses",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "options": { "type": "object" }
            }
          }
        ]
      }
    },
    "harnesses": {
      "type": "array",
      "description": "ACP agents hos runs as harnesses, configured by command, args and environment",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "command"],
        "properties": {
          "id": { "$ref": "#/$defs/harnessId" },
          "label": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "pool": { "$ref": "#/$defs/harnessId" },
          "slots": { "type": "integer", "minimum": 0 },
          "models": {
            "type": "object",
            "additionalProperties": false,
            "required": ["list"],
            "properties": {
              "default": { "type": "string" },
              "effort": { "$ref": "#/$defs/effort" },
              "list": { "$ref": "#/$defs/modelList" }
            }
          },
          "modes": { "type": "object", "additionalProperties": false, "properties": { "build": { "type": "string" }, "plan": { "type": "string" } } },
          "model_option": { "type": "string" },
          "effort_option": { "type": "string" },
          "memory_files": { "type": "array", "items": { "type": "string" } },
          "terminal": { "$ref": "#/$defs/command" },
          "login": { "$ref": "#/$defs/command" },
          "signed_in": { "$ref": "#/$defs/command" },
          "first_turn_note": { "type": "string" },
          "aliases": { "type": "array", "items": { "$ref": "#/$defs/harnessId" } }
        }
      }
    },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origins": {
          "type": "array",
          "description": "browser origins allowed to read GET /api/desk",
          "items": { "type": "string", "pattern": "^https?://[^/\\s]+$" }
        },
        "presence": {
          "type": "boolean",
          "description": "macOS only: sample idle time, screen lock, display sleep, camera and mic in use every 15 s and send them with the desk push to notifiers (default false; read at start)"
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/port" },
        "to": { "$ref": "#/$defs/port" }
      }
    },
    "mcp_servers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9-]+$", "not": { "const": "hos" } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "key_secret"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "key_secret": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "hide": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+\\*?$" } } }
    }
  },
  "$defs": {
    "mode": { "enum": ["ladder", "single"] },
    "tokens": { "type": "integer", "minimum": 1000, "maximum": 1000000 },
    "backstop": { "type": "integer", "minimum": 100000, "maximum": 1000000 },
    "count": { "type": "integer", "minimum": 0 },
    "pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "clock": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "outcome": { "enum": ["auto", "ask", "ask_every_time", "deny"] },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "harnessId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "modelList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contextOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "handoff": { "$ref": "#/$defs/tokens" },
        "backstop": { "$ref": "#/$defs/backstop" },
        "single_line": { "$ref": "#/$defs/tokens" }
      }
    },
    "approvalClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_t"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "lane_t": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
