{
  "name": "hos",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "hos": "dist/daemon/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/daemon/main.js",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "check": "node scripts/check.mjs",
    "check:e2e": "node scripts/check.mjs --e2e",
    "test:full": "node scripts/check.mjs --full"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/overpass-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@pierre/diffs": "^1.5.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "better-sqlite3": "^13.0.3",
    "elkjs": "0.12.0",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
